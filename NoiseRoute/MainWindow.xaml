<Window x:Class="NoiseRoute.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:oxy="http://oxyplot.org/wpf"
        Title="Noise Route" Width="1250" Height="800">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <DockPanel Margin="10">
            <Button Content="Сгенерировать заново"
                    Width="180"
                    Margin="0,0,10,0"
                    Click="Button_Click"/>
            <TextBlock VerticalAlignment="Center"
                       Text="{Binding Status}"
                       FontSize="16"/>
        </DockPanel>

        <Grid Grid.Row="1" HorizontalAlignment="Center" VerticalAlignment="Center" Margin="40">
            <Image Source="/MapView-1.png" Stretch="Fill" Margin="38,47,20,35"/>
            <oxy:PlotView Model="{Binding PlotModel}" Background="Transparent"/>
        </Grid>
    </Grid>
</Window>
